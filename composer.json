{
  "name": "arl-informatica/gestao",
  "type": "project",
  "description": "Gestão de assistência técnica ARL Informática",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "barryvdh/laravel-dompdf": "^3.1",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10",
    "minishlink/web-push": "^11.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php artisan test"
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }},
  "minimum-stability": "stable",
  "prefer-stable": true
}
