APP_NAME="ARL Informática"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_VERSION=0.1.0
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arl_informatica
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+00:00
SESSION_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
VAPID_SUBJECT=mailto:administracao@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APP_COMMIT=
BACKUP_DISK=local
BACKUP_MAX_UPLOAD_KB=512000
BACKUP_AUTOMATIC=false
BACKUP_FREQUENCY=daily
BACKUP_RETENTION=7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Gemini invoice reading. Keep disabled until paid API billing is configured.
GEMINI_EXPENSE_PHOTO_ENABLED=false
GEMINI_API_KEY=
GEMINI_EXPENSE_PHOTO_MODEL=gemini-3.1-pro-preview
GEMINI_EXPENSE_PHOTO_MONTHLY_READS=20
GEMINI_EXPENSE_PHOTO_MONTHLY_MICRO_USD=1000000

# Preferred invoice provider. Credentials only in the private .env.
EXPENSE_PHOTO_AI_PROVIDER=mistral
MISTRAL_EXPENSE_PHOTO_ENABLED=false
MISTRAL_API_KEY=
